{
  "manifest_version": 3,
  "name": "YouTube Transcript to AI",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Grab the transcript from the current YouTube video and open it in ChatGPT, Claude, or Gemini.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": ["https://sponsor.ajay.app/*"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "YouTube Transcript to AI",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["scripts/player-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["scripts/prompt-presets.js", "scripts/transcript-utils.js", "scripts/playback-utils.js", "scripts/youtube-content.js", "scripts/youtube-features.js"],
      "css": ["scripts/youtube-features.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["scripts/prompt-delivery.js", "scripts/ai-content.js"],
      "run_at": "document_idle"
    }
  ]
}
